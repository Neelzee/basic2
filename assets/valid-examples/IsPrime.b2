BEGIN MODULE IsPrime
INVOKE PRINT("Input a number to check for if its a prime:");
LET rawInp: STR = INPUT("> ");
LET n = LEN(rawInp);
LET prime: [BOOL] = [];
FOR (LET i = 0; i <= (n + 1); i++;) THEN
  prime = ADD(TRUE, prime);
END
LET p = 2;
WHILE ((p * p) <= n) DO
  IF (prime[p]) THEN
    LET i = p * p;
    WHILE (i <= (n + 1)) DO
      prime[i] = FALSE;
      i = i + p;
    END
    p = p + 1;
  FI
END
FOR (LET i = 2; i <= (n + 1); i++;) THEN
  IF (prime[i]) THEN
    INVOKE PRINT(i);
  FI
END
MODULE IsPrime END