BEGIN MODULE SkillExample
DECL id[T](T) : T;
IMPL id(n) RETURN n;

SKILL Orderable WHERE
  DECL gt(IT, IT) : BOOL;
END

INT KNOWS Orderable WITH
  IMPL gt(a, b) DOES
    RETURN a > b;
  END
END

SKILL Magma WHERE
  DECL binop(IT, IT) : IT;
END

SKILL Semigroup KNOWS Magma WHERE
  DECL combine(IT, IT) : IT;
END

DECL print2[T KNOWS SHOWABLE]([T]) : NIL;
IMPL print2(xs = []) WHEN xs THEN
  [] FOLLOWS
    INVOKE PRINT("Nothing to print!");
  END
  _ FOLLOWS
    INVOKE PRINT(xs);
  END
END

ENUMS Maybe[T]
  Something(T);
  Nothing;
END

STRUCTURE List[T] WHERE
  DECL head : Maybe[T];
  DECL tail : [List[T]];
END

MODULE SkillExample END