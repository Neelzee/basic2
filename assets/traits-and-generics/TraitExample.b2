BEGIN MODULE traits
DECL id[T](T) : T;
IMPL id(n) RETURN n;

TRAIT Orderable WHERE
  DECL gt(IT, IT) : BOOL;
END

TEACH Orderable TO INT
  IMPL gt(a, b) DOES
    RETURN a > b;
  END
END

TRAIT Magma WHERE
  DECL binop(IT, IT) : IT;
END

TRAIT Semigroup KNOWS Magma WHERE
  DECL combine(IT, IT) : Semigroup;
END

DECL print2[T KNOWS SHOWABLE]([T]) : NIL;
IMPL print2(xs = []) WHEN xs THEN
  [] FOLLOWS
    INVOKE PRINT("Nothing to print!");
  END
  _ FOLLOWS
    INVOKE PRINT(xs);
  END
END

ENUMS Maybe[T]
  Something(T);
  Nothing;
END

STRUCTURE List[T] WHERE
  DECL head : Maybe[T];
  DECL tail : [List[T]];
END

MODULE traits END