BEGIN MODULE traits
DECL id[T](T) : T;
IMPL id(n) RETURN n;

TRAIT Orderable WHERE
  DECL gt(IT, IT) : BOOL;
END

TEACH Orderable TO INT
  IMPL gt(a, b) DOES
    RETURN a > b;
  END
END

TRAIT Semigroup WHERE
  DECL combine(IT, IT) : Semigroup;
END

DECL print2[T KNOWS SHOWABLE]([T]) : NIL;
IMPL print2(xs = []) WHEN xs THEN
  [] FOLLOWS
    INVOKE PRINT("Nothing to print!");
  END
  _ FOLLOWS
    INVOKE PRINT(xs);
  END
END

MODULE traits END